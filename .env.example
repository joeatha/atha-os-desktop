# Copy to `.env` (gitignored) when building signed/notarized releases.
# ---- macOS signing (Developer ID Application cert must be in your login keychain) ----
# electron-builder auto-selects the Developer ID Application cert; to force one:
# CSC_NAME="Developer ID Application: Atha Enterprises LLC (TEAMID)"

# ---- macOS notarization (App Store Connect API key — preferred) ----
APPLE_API_KEY=./build/AuthKey_XXXXXXXXXX.p8
APPLE_API_KEY_ID=XXXXXXXXXX
APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000
# Also set build.mac.notarize.teamId in package.json to your 10-char Team ID.

# ---- Alternative: notarize with an app-specific password instead of an API key ----
# APPLE_ID=you@athaenterprises.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=XXXXXXXXXX

# ---- Publishing to GitHub Releases (auto-update feed) ----
GH_TOKEN=ghp_your_token_with_repo_scope

# ---- Windows signing (STUBBED — no cert yet) ----
# CSC_LINK=./build/win-cert.pfx
# CSC_KEY_PASSWORD=...
